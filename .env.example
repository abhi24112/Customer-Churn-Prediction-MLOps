# Used by scripts + DVC stage `db_snapshot`
# NOTE: for psycopg2, URL format is: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/churn

# Optional
DB_SCHEMA=public
RAW_TABLE=churn_raw
SNAPSHOT_CSV_PATH=src/data/raw_data/data.csv
RAW_CSV_PATH=src/data/raw_data/data.csv
